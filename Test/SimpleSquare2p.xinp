<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<simulation>

  <geometry dim="2" nx="2">
    <refine type="uniform" lowerpatch="1" upperpatch="2" u="7" v="7"/>
    <topologysets>
      <set name="Boundary" type="edge">
        <item patch="1">1 3 4</item>
        <item patch="2">2 3 4</item>
      </set>
    </topologysets>
  </geometry>

  <boundaryconditions>
    <dirichlet set="Boundary" comp="1" type="anasol"/>
  </boundaryconditions>

  <darcy>
    <source type="expression">
      uxx=2*y*(y-1);
      uyy=2*x*(x-1);
      -uxx-uyy
    </source>
    <anasol type="expression">
      <primary>x*(x-1)*y*(y-1)</primary>
      <secondary>-(2*x-1)*y*(y-1)|-(2*y-1)*x*(x-1)</secondary>
    </anasol>
    <gravity y="-1.0"/>
    <bodyforce>0.0 | 1.0</bodyforce>
    <permvalues>1.0 | 1.0</permvalues>
  </darcy>

</simulation>
