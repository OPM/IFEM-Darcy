<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<simulation>

  <!-- General - geometry definitions !-->
  <geometry dim="2" Lx="10" Ly="5">
    <refine patch="1" u="15" v="15"/>
    <topologysets>
      <set name="Edge4" type="edge">
        <item patch="1">4</item>
      </set>
    </topologysets>
  </geometry>

  <!-- General - boundary conditions !-->
  <boundaryconditions>
    <dirichlet set="Edge4" comp="1"/>
  </boundaryconditions>

  <!-- Problem-specific block !-->
  <darcy>
    <gravity y="-9.81"/>
    <bodyforce>0.0 | 9.81</bodyforce>
    <permvalues>1.2 | 1.2</permvalues>
    <source type="elementsum">
      # U V Val\
      0.25 0.25 9.81\
      0.75 0.75 9.81
    </source>
  </darcy>

</simulation>
