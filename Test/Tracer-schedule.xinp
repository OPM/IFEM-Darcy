<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<simulation>

  <!-- General - geometry definitions !-->
  <geometry dim="2">
    <raiseorder patch="1" u="1" v="1"/>
    <refine patch="1" u="7" v="7"/>
    <topologysets>
      <set name="Boundary" type="edge">
        <item patch="1">1 2 3 4</item>
      </set>
    </topologysets>
  </geometry>

  <!-- General - boundary conditions !-->
  <boundaryconditions>
    <dirichlet set="Boundary" comp="1"/>
  </boundaryconditions>

  <!-- General - numerical integration scheme !-->
  <discretization>
    <nGauss>3</nGauss>
  </discretization>

  <!-- Problem-specific block - for pressure solver !-->
  <darcy>
    <source type="expression">h=1; -2.0*(x*x-x+y*y-y)*h</source>
    <gravity y="-1.0"/>
    <bodyforce>0.0|1.0</bodyforce>
    <permvalues>1.0|1.0</permvalues>
    <porosity type="constant">1.0</porosity>
    <dispersivity type="constant">1.0</dispersivity>
    <viscosity>1.0</viscosity>
    <anasol type="expression">
      <variables>h=1</variables>
      <primary>x*(x-1)*y*(y-1)*h</primary>
      <secondary>-(2*x-1)*y*(y-1)*h | -x*(x-1)*(2*y-1)*h</secondary>
      <scalarprimary>x*(x-1)*y*(y-1)*h</scalarprimary>
      <scalarsecondary>(2*x-1)*y*(y-1)*h | x*(x-1)*(2*y-1)*h</scalarsecondary>
    </anasol>
    <schedule>
      <update time="0.5"/>
    </schedule>
  </darcy>

  <!-- Problem-specific block - for tracer concentration solver !-->
  <darcyadvection>
    <source type="expression">
        h=t;
        dh=1;
        c=x*(x-1)*y*(y-1)*h;
        ct=x*(x-1)*y*(y-1)*dh;
        px=(2*x-1)*y*(y-1)*h;
        py=x*(x-1)*(2*y-1)*h;
        cx=px;
        cy=py;
        p2x=2*y*(y-1)*h;
        p2y=2*x*(x-1)*h;
        ct - (cx*px + c*p2x + cy*py + c*p2y + p2x + p2y)
    </source>
  </darcyadvection>

  <!-- General - time-stepping setup !-->
  <timestepping start="0" end="1.0" dt="0.1" type="bdf2"/>

</simulation>
