<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<simulation>

  <!-- General - geometry definitions !-->
  <geometry dim="2">
    <raiseorder patch="1" u="1" v="1"/>
    <refine patch="1" u="7" v="7"/>
    <topologysets>
      <set name="Horizontal" type="edge">
        <item patch="1">3 4</item>
      </set>
    </topologysets>
  </geometry>

  <!-- General - boundary conditions !-->
  <boundaryconditions>
    <!-- Prescribed normal flux is imposed strongly on the q_y coefficients -->
    <dirichlet set="Horizontal" type="expression" basis="2" comp="1">
      -x*(x-1)*(2*y-1)
    </dirichlet>
  </boundaryconditions>

  <!-- General - numerical integration scheme !-->
  <discretization>
    <nGauss>3</nGauss>
  </discretization>

  <!-- Problem-specific block - for pressure solver !-->
  <darcy formulation="div-compatible">
    <source type="expression">-2.0*(x*x-x+y*y-y)</source>
    <gravity y="-1.0"/>
    <bodyforce>0.0|1.0</bodyforce>
    <permeability type="constant">1.0</permeability>
    <porosity type="constant">1.0</porosity>
    <dispersivity type="constant">1.0</dispersivity>
    <viscosity>1.0</viscosity>
    <schedule>
      <update time="0.5"/>
    </schedule>
  </darcy>

  <!-- Problem-specific block - for tracer concentration solver !-->
  <darcyadvection>
    <source type="expression">h=t; dh=1;
      c=(x*x-x)*(y*y-y)*h;
      ct=(x*x-x)*(y*y-y)*dh;
      px=(2*x-1)*(y*y-y)*h;
      py=(x*x-x)*(2*y-1)*h;
      cx=px;
      cy=py;
      p2x=2*(y*y-y)*h;
      p2y=2*(x*x-x)*h;
      ct - (cx*px + c*p2x + cy*py + c*p2y + p2x + p2y)
    </source>
  </darcyadvection>

  <!-- General - time-stepping setup !-->
  <timestepping start="0" end="1.0" dt="0.1" type="bdf2"/>

</simulation>
