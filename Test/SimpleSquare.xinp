<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<simulation>

  <geometry dim="2">
    <refine patch="1" u="7" v="7"/>
    <topologysets>
      <set name="Boundary" type="edge">
        <item patch="1">1 2 3 4</item>
      </set>
    </topologysets>
  </geometry>

  <boundaryconditions>
    <dirichlet set="Boundary" comp="1" type="anasol"/>
  </boundaryconditions>

  <darcy>
    <gravity y="-1.0"/>
    <bodyforce>0.0 | 1.0</bodyforce>
    <source type="expression">
      ut=x*(x-1)*y*(y-1);
      uxx=2*y*(y-1)*t;
      uyy=2*x*(x-1)*t;
      ut-uxx-uyy
    </source>
    <anasol type="expression">
      <primary>x*(x-1)*y*(y-1)*t</primary>
      <secondary>-(2*x-1)*y*(y-1)*t|-(2*y-1)*x*(x-1)*t</secondary>
    </anasol>
  </darcy>

  <timestepping start="0.0" end="1.0" dt="0.1" type="be"/>

</simulation>
